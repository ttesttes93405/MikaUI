# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/UserSettings/
/Unity/[Ll]ibrary/
/Unity/[Tt]emp/
/Unity/[Oo]bj/
/Unity/[Bb]uild/
/Unity/[Bb]uilds/
/Unity/[Ll]ogs/
/Unity/[Mm]emoryCaptures/
/Unity/Packages/packages-lock.json
/Unity/Assets/FR2_Cache.asset
/Unity/Assets/FR2_Cache.asset.meta
/Unity/UserSettings/
/Core/bin/
/Core/obj/
/Core.Test/bin/
/Core.Test/obj/


# Asset meta data should only be ignored when the corresponding asset is also ignored
!/Unity/[Aa]ssets/**/*.meta


# Visual Studio cache directory
.vs/
.vscode/

# Gradle cache directory
.gradle/

# Game-ci
/artifacts

# Autogenerated VS/MD/Consulo solution and project files
.consulo/
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
*.unitypackage.meta

*.csproj
*.sln
!/Core/*.csproj
!/Core.Test/*.csproj
!/MikaUI.sln


**/.DS_Store
*.DS_Store
.DS_Store
.DS_Store?
