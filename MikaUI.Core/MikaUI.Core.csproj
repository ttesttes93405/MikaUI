<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>MikaUI.Core</AssemblyName>
    <Version>1.0.1</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Keep the packaged DLL stable when only the repository commit changes. -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
  </ItemGroup>
  <Target Name="CopyReleaseToUnity" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <UnityCoreDirectory>$(MSBuildProjectDirectory)/../MikaUI.Unity/Assets/MikaUI/Runtime/Plugins</UnityCoreDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(UnityCoreDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityCoreDirectory)" SkipUnchangedFiles="true" />
  </Target>
</Project>
